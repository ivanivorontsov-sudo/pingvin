#!/bin/bash
# pingvin-tiho — браузер «Тихо» для ПК (Firefox ESR + политики приватности Тихо).
#   pingvin-tiho [url]                 — запуск
#   pingvin-tiho --install DIR [name]  — установить из распакованной сборки (Linux x86_64 tar.gz или Windows x64 zip)
# Сборки Тихо для ПК — это официальный Firefox ESR x86_64 + distribution/policies.json. Гнать x86_64 Firefox через
# box64 (или firefox.exe через Wine+FEX) на телефоне — медленно и ломается в proot. Поэтому берём из сборки только
# политики Тихо и запускаем их на встроенном родном arm64 Firefox ESR: отдельная копия /opt/NAME (симлинки на
# /usr/lib/firefox-esr, свой бинарь и свой distribution/) и отдельный профиль.
R=${PINGVIN_ROOT:-}

is_browser_helper() {
  case "$(basename "$1" | tr A-Z a-z)" in
    chrome-sandbox|chrome_crashpad_handler|crashpad_handler|crashreporter|crashreporter-bin|crashreporter.exe|crashhelper|crashhelper.exe|minidump-analyzer|minidump-analyzer.exe|updater|updater.exe|pingsender|pingsender.exe|plugin-container|plugin-container.exe|glxtest|vaapitest|default-browser-agent|default-browser-agent.exe|elevation_service|uninstall|uninstaller|update) return 0;;
  esac
  return 1
}
looks_like_tiho() { echo "$1" | tr A-Z a-z | grep -qE 'tiho|тихо'; }
already_tiho_wrapper() {
  [ -n "$1" ] || return 1
  case "$1" in *pingvin-tiho*) return 0;; esac
  [ -f "$1" ] && grep -q 'pingvin-tiho' "$1" 2>/dev/null && return 0
  return 1
}
rewrite_tiho_launcher() {
  local name="$1"
  [ -n "$name" ] || return 0
  local w="$R/usr/local/bin/$name"
  mkdir -p "$R/usr/local/bin" "$R/root/.pingvin/apps" "$R/usr/share/applications/pingvin"
  printf '#!/bin/sh\nexec pingvin-tiho --run tiho "$@"\n' > "$w"
  chmod +x "$w"
  printf 'name=%s\ncmd=%s\ngui=1\nlibs=\n' "$name" "$w" > "$R/root/.pingvin/apps/$name.properties"
  cat > "$R/usr/share/applications/pingvin/$name.desktop" <<D
[Desktop Entry]
Type=Application
Name=Тихо
Comment=Приватный браузер Тихо (Firefox ESR + uBlock Origin)
Exec=$w %u
Icon=firefox-esr
Terminal=false
Categories=Network;WebBrowser;
D
  echo "pingvin-tiho: ярлык «$name» перенаправлен на родной Тихо (Firefox ESR)"
}

migrate_tiho() {
  local name cmd pf df w ex key d
  # Каталоги /opt/*tiho* без родной сборки (.pingvin-base)
  for d in "$R"/opt/*; do
    [ -d "$d" ] || continue
    looks_like_tiho "$(basename "$d")" || continue
    [ -f "$d/.pingvin-base" ] && [ -x "$d/firefox-esr" ] && continue
    rewrite_tiho_launcher "$(basename "$d")"
  done
  # Записи программ и обёртки
  for pf in "$R"/root/.pingvin/apps/*.properties; do
    [ -f "$pf" ] || continue
    name=$(sed -n 's/^name=//p' "$pf" | head -1)
    cmd=$(sed -n 's/^cmd=//p' "$pf" | head -1)
    key=$(basename "$pf" .properties)
    already_tiho_wrapper "$cmd" && continue
    if looks_like_tiho "$key" || looks_like_tiho "$name" || looks_like_tiho "$cmd"; then
      rewrite_tiho_launcher "$key"
    elif [ -n "$cmd" ] && { is_browser_helper "$cmd" || echo "$cmd" | grep -qiE 'crashreporter|pingsender|/updater$'; }; then
      if looks_like_tiho "$cmd" || grep -ql 'Name=Firefox' "$(dirname "$cmd")/application.ini" 2>/dev/null; then
        rewrite_tiho_launcher "$key"
      fi
    fi
  done
  for w in "$R"/usr/local/bin/tiho* "$R"/usr/local/bin/*тихо* "$R"/usr/local/bin/win-tiho* "$R"/usr/local/bin/win-*тихо*; do
    [ -e "$w" ] || continue
    already_tiho_wrapper "$w" && continue
    looks_like_tiho "$w" || continue
    rewrite_tiho_launcher "$(basename "$w")"
  done
  for df in "$R"/usr/share/applications/pingvin/*.desktop \
            "$R"/usr/share/applications/*.desktop \
            "$R"/root/.local/share/applications/*.desktop \
            "$R"/root/.local/share/applications/wine/*.desktop \
            "$R"/root/.local/share/applications/wine/Programs/*.desktop; do
    [ -f "$df" ] || continue
    ex=$(grep -m1 '^Exec=' "$df" | cut -d= -f2-)
    echo "$df $ex" | tr A-Z a-z | grep -qE 'tiho|тихо' || continue
    echo "$ex" | grep -q pingvin-tiho && continue
    key=$(basename "$df" .desktop)
    key=${key#pingvin-win-}
    rewrite_tiho_launcher "$key"
    # исходный .desktop (в т.ч. wine/Programs) тоже переписываем на месте
    if ! grep -q pingvin-tiho "$df" 2>/dev/null; then
      sed -i "s|^Exec=.*|Exec=pingvin-tiho --run tiho %u|" "$df"
      grep -q '^Name=' "$df" && sed -i "s|^Name=.*|Name=Тихо|" "$df" || true
    fi
  done
  # Канонический «tiho», если есть встроенный Firefox (не в тестах)
  if [ -z "$PINGVIN_MIGRATE_SKIP_BUILD" ] && [ -z "$PINGVIN_ROOT" ]; then
    if [ ! -x /usr/local/bin/tiho ] || [ ! -x /opt/tiho/firefox-esr ]; then
      if [ -x "${PINGVIN_FF_DIR:-/usr/lib/firefox-esr}/firefox-esr" ]; then
        PINGVIN_TITLE=Тихо "$0" --install /opt/pingvin tiho || echo "pingvin-tiho: не удалось сразу собрать /opt/tiho — соберётся при первом запуске"
      fi
    fi
  elif [ ! -e "$R/usr/local/bin/tiho" ]; then
    rewrite_tiho_launcher tiho
  fi
}

if [ "$1" = --is-helper ]; then
  is_browser_helper "$2"; exit $?
fi
if [ "$1" = --migrate ]; then
  migrate_tiho
  exit 0
fi

FF=${PINGVIN_FF_DIR:-/usr/lib/firefox-esr}
if [ "$1" = --install ]; then
  src="${2%/}"; name=${3:-tiho}; T=/opt/$name; title=${PINGVIN_TITLE:-Тихо}
  [ -d "$src" ] || src=/opt/pingvin
  pol=$(find "$src" -maxdepth 4 -path '*/distribution/policies.json' 2>/dev/null | head -1)
  [ -z "$pol" ] && [ -f /opt/pingvin/tiho-policies.json ] && pol=/opt/pingvin/tiho-policies.json
  mkdir -p /root/.pingvin/$name.d
  [ -n "$pol" ] && cp -f "$pol" /root/.pingvin/$name.d/policies.json
  rd=$(find "$src" -maxdepth 3 -iname 'README-TIHO*' 2>/dev/null | head -1); [ -n "$rd" ] && cp -f "$rd" /root/.pingvin/$name.d/README.txt
  echo "$title" > /root/.pingvin/$name.d/title
  rm -rf "$T"; "$0" --build "$name" || exit 2
  w=/usr/local/bin/$name; printf '#!/bin/sh\nexec pingvin-tiho --run %s "$@"\n' "$name" > "$w"; chmod +x "$w"
  mkdir -p /root/.pingvin/apps /usr/share/applications/pingvin
  printf 'name=%s\ncmd=%s\ngui=1\nlibs=\n' "$name" "$w" > /root/.pingvin/apps/$name.properties
  ic=firefox-esr; [ -f /root/.pingvin/$name.d/icon.png ] && ic=/root/.pingvin/$name.d/icon.png
  cat > /usr/share/applications/pingvin/$name.desktop <<D
[Desktop Entry]
Type=Application
Name=$title
Comment=Приватный браузер $title (Firefox ESR + uBlock Origin)
Exec=$w %u
Icon=$ic
Terminal=false
Categories=Network;WebBrowser;
D
  command -v pingvin-menu-refresh >/dev/null && pingvin-menu-refresh
  echo "PINGVIN_APP $name -> $w (gui=1)"
  echo "«$title» установлен: родной arm64 Firefox ESR с политиками $title ($([ -n "$pol" ] && echo "политики взяты из сборки" || echo "политик в сборке нет")). Ярлык — в меню и на рабочем столе."
  exit 0
fi
if [ "$1" = --build ]; then  # собрать /opt/NAME поверх встроенного Firefox
  name=$2; T=/opt/$name
  [ -x "$FF/firefox-esr" ] || { echo "Нет встроенного Firefox ($FF)"; exit 1; }
  mkdir -p "$T"
  for f in "$FF"/* "$FF"/.[!.]*; do [ -e "$f" ] || continue; b=$(basename "$f")
    case "$b" in firefox-esr|firefox-bin|firefox|distribution) ;; *) ln -sfn "$f" "$T/$b";; esac; done
  # бинарь — настоящей копией: Firefox ищет distribution/ рядом с реальным путём исполняемого файла
  cp -f "$FF/firefox-esr" "$T/firefox-esr"; ln -sfn firefox-esr "$T/firefox-bin"
  rm -rf "$T/distribution"; mkdir -p "$T/distribution"
  [ -d "$FF/distribution/" ] && cp -rL "$FF/distribution/." "$T/distribution/" 2>/dev/null
  [ -f /root/.pingvin/$name.d/policies.json ] && cp -f /root/.pingvin/$name.d/policies.json "$T/distribution/policies.json"
  cmp -s "$FF/firefox-esr" "$T/firefox-esr" && echo "$FF/firefox-esr" > "$T/.pingvin-base"
  exit 0
fi
name=tiho; [ "$1" = --run ] && { name=$2; shift 2; }
T=/opt/$name
if [ -z "$DISPLAY" ]; then exec pingvin-gui pingvin-tiho --run "$name" "$@"; fi
# встроенный Firefox мог обновиться/доустановиться — пересобрать копию
if [ ! -x "$FF/firefox-esr" ] || ! cmp -s "$FF/firefox-esr" "$T/firefox-esr"; then
  [ -x "$FF/firefox-esr" ] || PINGVIN_FF_ENSURE=1 pingvin-browser --ensure-only
  "$0" --build "$name" || exit 1
fi
export PINGVIN_FF_BIN="$T/firefox-esr" PINGVIN_FF_PROFILE="/root/.pingvin/$name-profile"
exec pingvin-browser "${1:-about:home}"
