#!/bin/bash
# pingvin-launch FILE.desktop — запуск программы из меню (Wine-ярлыки, deb, AppImage).
f="$1"; [ -f "$f" ] || { echo "нет $f"; exit 1; }
[ -z "$DISPLAY" ] && exec pingvin-gui pingvin-launch "$@"
ex=$(grep -m1 '^Exec=' "$f" | cut -d= -f2- | sed -E 's/ ?%[fFuUdDnNickvm]//g')
dir=$(grep -m1 '^Path=' "$f" | cut -d= -f2-); [ -n "$dir" ] && cd "$dir" 2>/dev/null
echo "Запуск: $ex"
if echo "$ex" | grep -qiE '(^|[ /])wine(64)?( |$)|\.exe|\.lnk'; then
  case "${PINGVIN_WINE_I386:-box64}" in fex) export HODLL=libwow64fex.dll;; *) export HODLL=wowbox64.dll;; esac
  export BOX64_LOG=0 BOX64_NOBANNER=1 WINEPREFIX=${WINEPREFIX:-/root/.wine} WINEDEBUG=${WINEDEBUG:--all}
  pingvin-wine --prepare || exit 1
fi
case "$ex" in pingvin-*|env\ *) eval "exec $ex";; *) eval "exec pingvin-run $ex";; esac
